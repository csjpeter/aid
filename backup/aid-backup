#!/bin/bash
# Single entry point for all backups on this machine.
#   aid-backup {github|claude|t14|status|all} [args passed to the sub-script]
set -euo pipefail
DIR="$(dirname "$(readlink -f "$0")")"

usage() {
    cat <<USG
Usage: $(basename "$0") <command> [args]

Commands:
  github   GitHub repos -> ~/backup/github        (github-sync.sh)
  claude   ~/.claude, userdata -> ~/backup/claude (claude-backup.sh backup)
  t14      t14-only repos and folders             (t14-backup.sh backup)
  status   Status of every backup
  all      github, claude and t14 in sequence; reports every failure
USG
}

run_all() {
    local failed=0 step
    for step in github claude t14; do
        echo "=== $step ==="
        "$0" "$step" || { echo "[ERROR] $step failed" >&2; failed=$((failed + 1)); }
    done
    return "$failed"
}

case "${1:-help}" in
    github) shift; "$DIR/github-sync.sh" "$@" ;;
    claude) shift; "$DIR/claude-backup.sh" backup "$@" ;;
    t14)    shift; "$DIR/t14-backup.sh" backup "$@" ;;
    status)
        "$DIR/claude-backup.sh" status
        "$DIR/t14-backup.sh" status
        echo "github: $(ls -1d "${GITHUB_REPOS_DIR:-$HOME/backup/github}"/*/ | wc -l) repos, last log: $(ls -1t "${GITHUB_REPOS_DIR:-$HOME/backup/github}"/.sync-*.log | head -1)"
        ;;
    all)    run_all ;;
    help|--help|-h) usage ;;
    *) echo "Unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
